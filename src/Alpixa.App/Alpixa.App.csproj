<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(AlpixaVerifyBuild)' == 'true'">net10.0</TargetFrameworks>

    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>
    <NoWarn Condition="'$(TargetFramework)' == 'net10.0'">$(NoWarn);CA1416</NoWarn>
    <RootNamespace>Alpixa.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <NoWarn>$(NoWarn);XC0022;XC0025;MVVMTK0045</NoWarn>

    <ApplicationTitle>Alpixa</ApplicationTitle>
    <ApplicationId>com.alpixa.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <NeutralLanguage>tr</NeutralLanguage>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>Platforms\Windows\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <CodesignEntitlements Condition="'$(Configuration)' == 'Debug'">Platforms\MacCatalyst\Entitlements.Debug.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(Configuration)' != 'Debug'">Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
    <RuntimeIdentifiers>maccatalyst-arm64;maccatalyst-x64</RuntimeIdentifiers>
    <!-- EF Core, Scriban and CsvHelper generate code at run time. Keep AOT for speed but allow the
         interpreter for that dynamic code, otherwise Release builds fail with "Model building is not
         supported when publishing with NativeAOT". -->
    <MtouchInterpreter Condition="'$(Configuration)' != 'Debug'">-all</MtouchInterpreter>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#6366F1" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#6366F1" BaseSize="128,128" />
    <EmbeddedResource Include="appsettings.json" LogicalName="Alpixa.App.appsettings.json" />
    <!-- Fixed manifest name so ResourceManager finds the strings on every platform. -->
    <EmbeddedResource Update="Resources\Strings\AppResources*.resx" ManifestResourceName="Alpixa.App.Resources.Strings.%(Filename)" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Alpixa.Core\Alpixa.Core.csproj" />
    <ProjectReference Include="..\Alpixa.Infrastructure\Alpixa.Infrastructure.csproj" />
    <ProjectReference Include="..\Alpixa.Sending\Alpixa.Sending.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="H.NotifyIcon.WinUI" />
  </ItemGroup>

</Project>
