<?xml version="1.0" encoding="utf-8" ?>
<views:AlpixaPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:views="clr-namespace:Alpixa.App.Views"
                     xmlns:vm="clr-namespace:Alpixa.App.ViewModels"
                     xmlns:loc="clr-namespace:Alpixa.App.Services"
                     xmlns:fx="clr-namespace:Alpixa.App.Controls"
                     xmlns:r="clr-namespace:Alpixa.Core.Rules;assembly=Alpixa.Core"
                     x:Class="Alpixa.App.Views.ProfileEditPage"
                     x:DataType="vm:ProfileEditViewModel"
                     Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="36,28,36,36" Spacing="18" MaximumWidthRequest="940" HorizontalOptions="Start">
            <fx:PageHeader Title="{Binding Title}" Subtitle="{loc:Tr ProfileEdit_Subtitle}" Icon="Mail" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <fx:InfoLabel Text="{loc:Tr ProfileEdit_Provider}" Info="ProfileEdit_Provider" LabelStyle="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" ItemDisplayBinding="{Binding DisplayName, x:DataType=r:ProviderPreset}" />
                    <Label Text="{loc:Tr ProfileEdit_ProviderHint}" Style="{StaticResource MutedLabel}" />

                    <fx:InfoLabel Text="{loc:Tr ProfileEdit_Name}" Info="ProfileEdit_Name" LabelStyle="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Profile.Name}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout>
                            <fx:InfoLabel Text="{loc:Tr ProfileEdit_FromName}" Info="ProfileEdit_FromName" LabelStyle="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Profile.FromName}" Placeholder="Firmanız" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <fx:InfoLabel Text="{loc:Tr ProfileEdit_FromAddress}" Info="ProfileEdit_FromAddress" LabelStyle="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Profile.FromAddress}" Placeholder="bulten@firmaniz.com" Keyboard="Email" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout>
                            <fx:InfoLabel Text="{loc:Tr ProfileEdit_ReplyTo}" Info="ProfileEdit_ReplyTo" LabelStyle="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Profile.ReplyTo}" Placeholder="destek@firmaniz.com" Keyboard="Email" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <fx:InfoLabel Text="{loc:Tr ProfileEdit_PostalAddress}" Info="ProfileEdit_PostalAddress" LabelStyle="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Profile.PostalAddress}" Placeholder="{loc:Tr ProfileEdit_PostalAddressHint}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <fx:InfoLabel Text="{loc:Tr ProfileEdit_SignInTitle}" Info="ProfileEdit_SignInTitle" LabelStyle="{StaticResource SectionTitle}" />
                    <Label Text="{loc:Tr ProfileEdit_NoAuth}" Style="{StaticResource MutedLabel}" IsVisible="{Binding IsNoAuth}" />
                    <VerticalStackLayout IsVisible="{Binding IsOAuthProvider}" Spacing="6">
                        <Label Text="{loc:Tr ProfileEdit_OAuthHint}" Style="{StaticResource MutedLabel}" />
                        <HorizontalStackLayout Spacing="10">
                            <fx:WithInfo Info="ProfileEdit_SignIn" IsVisible="{Binding UseAppPassword, Converter={StaticResource Invert}}">
                                <Button Text="{loc:Tr ProfileEdit_SignIn}" Command="{Binding SignInCommand}" />
                            </fx:WithInfo>
                            <Label Text="{Binding SignInStatus}" VerticalOptions="Center" TextColor="{StaticResource StatusPass}" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <CheckBox IsChecked="{Binding UseAppPassword}" VerticalOptions="Center" />
                            <fx:InfoLabel Text="{loc:Tr ProfileEdit_UseAppPassword}" Info="ProfileEdit_UseAppPassword" Wrap="True" Grid.Column="1" VerticalOptions="Center" />
                        </Grid>
                        <Border Style="{StaticResource InsetBox}" IsVisible="{Binding UseAppPassword}">
                            <Label Text="{loc:Tr ProfileEdit_AppPasswordHelp}" Style="{StaticResource MutedLabel}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding ShowPassword}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout>
                                <fx:InfoLabel Text="{loc:Tr ProfileEdit_Username}" Info="ProfileEdit_Username" LabelStyle="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding Profile.Username}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <fx:InfoLabel Text="{loc:Tr ProfileEdit_Password}" Info="ProfileEdit_Password" LabelStyle="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding Password}" IsPassword="True" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{loc:Tr ProfileEdit_PasswordStored}" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <fx:InfoLabel Text="{loc:Tr ProfileEdit_LimitsTitle}" Info="ProfileEdit_LimitsTitle" LabelStyle="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                        <VerticalStackLayout>
                            <fx:InfoLabel Text="{loc:Tr ProfileEdit_Daily}" Info="ProfileEdit_Daily" LabelStyle="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Profile.DailyLimit}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <fx:InfoLabel Text="{loc:Tr ProfileEdit_Hourly}" Info="ProfileEdit_Hourly" LabelStyle="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Profile.HourlyLimit}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <fx:InfoLabel Text="{loc:Tr ProfileEdit_PerMinute}" Info="ProfileEdit_PerMinute" LabelStyle="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Profile.PerMinuteLimit}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding Profile.WarmupEnabled}" VerticalOptions="Center" />
                        <fx:InfoLabel Text="{loc:Tr ProfileEdit_Warmup}" Info="ProfileEdit_Warmup" Wrap="True" Grid.Column="1" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{loc:Tr ProfileEdit_WarmupHint}" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <CheckBox IsChecked="{Binding ShowAdvanced}" VerticalOptions="Center" />
                <fx:InfoLabel Text="{loc:Tr Common_ShowAdvanced}" Info="Common_ShowAdvanced" Wrap="True" Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold" />
            </Grid>

            <VerticalStackLayout IsVisible="{Binding ShowAdvanced}" Spacing="16">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <fx:InfoLabel Text="{loc:Tr ProfileEdit_ServerTitle}" Info="ProfileEdit_ServerTitle" LabelStyle="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="16">
                            <VerticalStackLayout>
                                <fx:InfoLabel Text="{loc:Tr ProfileEdit_Host}" Info="ProfileEdit_Host" LabelStyle="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding Profile.SmtpHost}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <fx:InfoLabel Text="{loc:Tr ProfileEdit_Port}" Info="ProfileEdit_Port" LabelStyle="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding Profile.SmtpPort}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <fx:InfoLabel Text="{loc:Tr ProfileEdit_Security}" Info="ProfileEdit_Security" LabelStyle="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding SecurityOptions}" SelectedItem="{Binding Profile.Security}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <fx:InfoLabel Text="{loc:Tr ProfileEdit_DkimTitle}" Info="ProfileEdit_DkimTitle" LabelStyle="{StaticResource SectionTitle}" />
                        <Label Text="{loc:Tr ProfileEdit_DkimHint}" Style="{StaticResource MutedLabel}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout>
                                <fx:InfoLabel Text="{loc:Tr ProfileEdit_DkimSelector}" Info="ProfileEdit_DkimSelector" LabelStyle="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding Profile.DkimSelector}" Placeholder="s1" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <fx:InfoLabel Text="{loc:Tr ProfileEdit_DkimDomain}" Info="ProfileEdit_DkimDomain" LabelStyle="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding Profile.DkimDomain}" Placeholder="firmaniz.com" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,8,0,0">
                            <CheckBox IsChecked="{Binding DkimEnabled}" VerticalOptions="Center" />
                            <fx:InfoLabel Text="{loc:Tr ProfileEdit_DkimSign}" Info="ProfileEdit_DkimSign" Wrap="True" Grid.Column="1" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding DkimEnabled}">
                            <Entry Text="{Binding Profile.DkimPrivateKeyPath}" Placeholder="{loc:Tr ProfileEdit_DkimKeyPath}" />
                            <fx:WithInfo Info="ProfileEdit_Common_Browse" Grid.Column="1">
                                <Button Text="{loc:Tr Common_Browse}" Style="{StaticResource SecondaryButton}" Command="{Binding PickDkimKeyCommand}" />
                            </fx:WithInfo>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <fx:InfoLabel Text="{loc:Tr ProfileEdit_ImapTitle}" Info="ProfileEdit_ImapTitle" LabelStyle="{StaticResource SectionTitle}" />
                        <Label Text="{loc:Tr ProfileEdit_ImapHint}" Style="{StaticResource MutedLabel}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <CheckBox IsChecked="{Binding ImapEnabled}" VerticalOptions="Center" />
                            <fx:InfoLabel Text="{loc:Tr ProfileEdit_ImapEnable}" Info="ProfileEdit_ImapEnable" Wrap="True" Grid.Column="1" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding ImapEnabled}">
                            <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="16">
                                <VerticalStackLayout>
                                    <fx:InfoLabel Text="{loc:Tr ProfileEdit_Host}" Info="ProfileEdit_Host" LabelStyle="{StaticResource FieldLabel}" />
                                    <Entry Text="{Binding Profile.ImapHost}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <fx:InfoLabel Text="{loc:Tr ProfileEdit_Port}" Info="ProfileEdit_Port" LabelStyle="{StaticResource FieldLabel}" />
                                    <Entry Text="{Binding Profile.ImapPort}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <fx:InfoLabel Text="{loc:Tr ProfileEdit_Security}" Info="ProfileEdit_Security" LabelStyle="{StaticResource FieldLabel}" />
                                    <Picker ItemsSource="{Binding SecurityOptions}" SelectedItem="{Binding Profile.ImapSecurity}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <VerticalStackLayout>
                                    <fx:InfoLabel Text="{loc:Tr ProfileEdit_ImapUsername}" Info="ProfileEdit_ImapUsername" LabelStyle="{StaticResource FieldLabel}" />
                                    <Entry Text="{Binding Profile.ImapUsername}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" IsVisible="{Binding ShowPassword}">
                                    <fx:InfoLabel Text="{loc:Tr ProfileEdit_Password}" Info="ProfileEdit_Password" LabelStyle="{StaticResource FieldLabel}" />
                                    <Entry Text="{Binding ImapPassword}" IsPassword="True" />
                                </VerticalStackLayout>
                            </Grid>
                            <fx:WithInfo Info="ProfileEdit_TestImap" HorizontalOptions="Start" Margin="0,8,0,0">
                                <Button Text="{loc:Tr ProfileEdit_TestImap}" Style="{StaticResource SecondaryButton}" Command="{Binding TestImapCommand}" />
                            </fx:WithInfo>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <fx:WithInfo Info="ProfileEdit_Common_Save">
                    <Button Text="{loc:Tr Common_Save}" Command="{Binding SaveCommand}" />
                </fx:WithInfo>
                <fx:WithInfo Info="Profiles_Test">
                    <Button Text="{loc:Tr Profiles_Test}" Style="{StaticResource SecondaryButton}" Command="{Binding TestSmtpCommand}" />
                </fx:WithInfo>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Label Text="{Binding BusyText}" VerticalOptions="Center" Style="{StaticResource MutedLabel}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:AlpixaPage>
